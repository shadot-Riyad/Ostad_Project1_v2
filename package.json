{
  "name": "Ostad_Riyad_v2",
  "version": "1.0.0",
  "description": "Demo Web Shop UI automation (Playwright + POM)",
  "type": "module",
  "scripts": {
    "clean": "rimraf allure-results allure-report playwright-report",
    "pw:all": "playwright test",
    "pw:q1": "playwright test tests/q1-invalid-login.spec.js",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report:html": "playwright show-report playwright-report",
    "test:q1": "run-s -c clean pw:q1 report:generate",
    "test:ui": "run-s -c clean pw:all report:generate",
    "test:headed": "playwright test --headed",
    "install:browsers": "playwright install firefox"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1"
  }
}
